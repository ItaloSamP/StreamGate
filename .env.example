# Exemplo de configuracao local do StreamGate.
# Copie este arquivo para `.env` e ajuste os valores conforme necessario.
# Nunca suba o `.env` real para o Git.

# Nome do projeto no Docker Compose.
COMPOSE_PROJECT_NAME=streamgate

# Frontend e API no profile de aplicacao.
WEB_PORT=5173
API_PORT=3000
VITE_API_BASE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=streamgate
POSTGRES_TEST_DB=streamgate_test
POSTGRES_USER=streamgate
POSTGRES_PASSWORD=streamgate123
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=streamgate
RABBITMQ_DEFAULT_PASS=streamgate123
WORKER_MAX_RETRIES=3

# Broker topology (worker runtime)
BROKER_EXCHANGE=streamgate.events
BROKER_UPLOAD_RECEIVED_ROUTING_KEY=upload.received.v1
BROKER_UPLOAD_RECEIVED_QUEUE=streamgate.worker.upload.received.v1
BROKER_UPLOAD_RECEIVED_DLQ=streamgate.worker.upload.received.v1.dlq
BROKER_UPLOAD_RECEIVED_DLQ_ROUTING_KEY=upload.received.v1.dlq
BROKER_MANAGEMENT_URL=http://rabbitmq:15672/api

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=streamgate
MINIO_ROOT_PASSWORD=streamgate123
MINIO_BUCKET_RAW=streamgate-uploads
MINIO_CORS_ALLOWED_ORIGIN=http://localhost:5173

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_DB=streamgate
CLICKHOUSE_USER=streamgate
CLICKHOUSE_PASSWORD=streamgate123

# Auth (fundacao de autenticacao)
# Tempo de vida da sessao em horas.
AUTH_SESSION_TTL_HOURS=24
# Tempo de vida do token de reset em minutos.
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# Pepper para digest de token (trocar em producao).
AUTH_TOKEN_PEPPER=streamgate-local-dev-pepper
# Estrategia de sessao da SPA.
AUTH_SESSION_TRANSPORT=bearer
# Sem cookies para auth na estrategia atual.
AUTH_COOKIE_ENABLED=false
# Modo de CSRF da API (token por padrao para estrategia bearer).
AUTH_CSRF_MODE=token
DEFAULT_ORGANIZATION_ID=org_default
AUDIT_RETENTION_DAYS=180
OPERATIONAL_READS_SLO_P95_MS=500
OPERATIONAL_READS_ERROR_BUDGET_PERCENT=1

# Auth throttling (hardening)
AUTH_LOGIN_LIMIT_PER_IP=30
AUTH_LOGIN_LIMIT_PER_IDENTIFIER=10
AUTH_REGISTER_LIMIT_PER_IP=10
AUTH_PASSWORD_RESET_REQUEST_LIMIT_PER_IP=10
AUTH_PASSWORD_RESET_REQUEST_LIMIT_PER_IDENTIFIER=5
AUTH_PASSWORD_RESET_CONFIRM_LIMIT_PER_IP=10
AUTH_THROTTLE_WINDOW_SECONDS=60

# Upload readiness (gate de prontidao -> entrega de upload/job)
# Endpoint S3-compativel usado pela API para gerar URL assinada.
UPLOAD_STORAGE_ENDPOINT=http://minio:9000
# Bucket oficial para artefatos de upload da v1.
UPLOAD_STORAGE_BUCKET=streamgate-uploads
# Regiao logica (MinIO aceita valor simbolico).
UPLOAD_STORAGE_REGION=us-east-1
# TTL da URL assinada em segundos.
UPLOAD_SIGNED_URL_TTL_SECONDS=900
# Modo de assinatura planejado para a trilha base.
UPLOAD_SIGNED_URL_MODE=presigned_put
# Credenciais S3-compativeis (MinIO no ambiente local).
UPLOAD_STORAGE_ACCESS_KEY=streamgate
UPLOAD_STORAGE_SECRET_KEY=streamgate123
# Allowlist inicial de content type para entrega de upload/job base.
UPLOAD_ALLOWED_CONTENT_TYPES=application/zip,text/csv
# Rate limit para signed-url e register (por IP).
UPLOAD_SIGNED_URL_LIMIT_PER_IP=30
UPLOAD_REGISTER_LIMIT_PER_IP=30
UPLOAD_THROTTLE_WINDOW_SECONDS=60
# Exige validacao do objeto no storage antes de registrar upload/job.
UPLOAD_VERIFY_OBJECT_BEFORE_REGISTER=true
# CORS da API
API_CORS_ALLOWED_ORIGINS=http://localhost:5173
API_CORS_ALLOW_CREDENTIALS=false

# Runtime operacional seguro
OPERATIONAL_ACTION_COOLDOWN_SECONDS=60
OPERATIONAL_ACTION_DAILY_LIMIT=25
IDEMPOTENCY_KEY_TTL_SECONDS=86400
JOB_ARTIFACT_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_DELIVERY_RETENTION_DAYS=30
DLQ_REPLAY_REQUEST_RETENTION_DAYS=30
ARTIFACT_DOWNLOAD_URL_TTL_SECONDS=300

# Smokes operacionais seguros
SMOKE_OPERATOR_EMAIL=operator@streamgate.local
SMOKE_ADMIN_EMAIL=admin@streamgate.local
SMOKE_SECOND_ADMIN_EMAIL=second-admin@streamgate.local
SMOKE_SECOND_ADMIN_PASSWORD=ChangeMe123!
SMOKE_NOTIFICATION_EMAIL=ops@streamgate.local
SMOKE_WEBHOOK_URL=https://hooks.example.test/streamgate
SMOKE_PUBLIC_LINK_URL=https://raw.githubusercontent.com/plotly/datasets/master/2014_apple_stock.csv
SMOKE_HTTP_TIMEOUT_SECONDS=60
SMOKE_WORKER_TIMEOUT_SECONDS=180
SMOKE_POLL_INTERVAL_SECONDS=3

# Seeds (dev/CI)
SEED_OPERATOR_PASSWORD=ChangeMe123!
SEED_ADMIN_PASSWORD=ChangeMe123!
