# Exemplo de configuracao local do StreamGate.
# Copie este arquivo para `.env` e preencha com os valores da sua maquina.
# Nunca suba o `.env` real para o Git.

# Nome do projeto no Docker Compose.
COMPOSE_PROJECT_NAME=your_project_name

# PostgreSQL
# Nome do banco usado no ambiente local.
POSTGRES_DB=your_postgres_database
# Usuario que a API e ferramentas locais usarao para conectar.
POSTGRES_USER=your_postgres_user
# Senha do usuario acima.
POSTGRES_PASSWORD=your_postgres_password
# Porta publicada na sua maquina.
POSTGRES_PORT=5432

# Redis
# Porta publicada na sua maquina.
REDIS_PORT=6379

# RabbitMQ
# Porta AMQP usada pela API e pelos workers.
RABBITMQ_PORT=5672
# Porta do painel administrativo do RabbitMQ.
RABBITMQ_MANAGEMENT_PORT=15672
# Usuario administrador local.
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
# Senha do usuario administrador local.
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# MinIO
# Porta da API S3-compatible.
MINIO_API_PORT=9000
# Porta do console web do MinIO.
MINIO_CONSOLE_PORT=9001
# Usuario raiz do MinIO local.
MINIO_ROOT_USER=your_minio_root_user
# Senha raiz do MinIO local.
MINIO_ROOT_PASSWORD=your_minio_root_password
# Bucket que recebera os arquivos brutos de upload.
MINIO_BUCKET_RAW=your_raw_uploads_bucket

# ClickHouse
# Porta HTTP do ClickHouse.
CLICKHOUSE_HTTP_PORT=8123
# Porta nativa TCP do ClickHouse.
CLICKHOUSE_NATIVE_PORT=9002
# Nome do banco analitico local.
CLICKHOUSE_DB=your_clickhouse_database
# Usuario da base analitica.
CLICKHOUSE_USER=your_clickhouse_user
# Senha do usuario acima.
CLICKHOUSE_PASSWORD=your_clickhouse_password
