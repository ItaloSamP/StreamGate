# Exemplo de configuracao local do StreamGate.
# Copie este arquivo para `.env` e ajuste os valores conforme necessario.
# Nunca suba o `.env` real para o Git.

# Nome do projeto no Docker Compose.
COMPOSE_PROJECT_NAME=streamgate

# Frontend e API no profile de aplicacao.
WEB_PORT=5173
API_PORT=3000

# PostgreSQL
POSTGRES_DB=streamgate
POSTGRES_USER=streamgate
POSTGRES_PASSWORD=streamgate123
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=streamgate
RABBITMQ_DEFAULT_PASS=streamgate123

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=streamgate
MINIO_ROOT_PASSWORD=streamgate123
MINIO_BUCKET_RAW=streamgate-uploads

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_DB=streamgate
CLICKHOUSE_USER=streamgate
CLICKHOUSE_PASSWORD=streamgate123
