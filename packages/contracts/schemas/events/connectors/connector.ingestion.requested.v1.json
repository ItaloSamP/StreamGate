{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamgate.local/contracts/events/connectors/connector.ingestion.requested.v1.json",
  "title": "ConnectorIngestionRequestedV1",
  "type": "object",
  "required": ["event_id", "event_name", "occurred_at", "producer", "payload_version", "correlation_id", "trace_id", "request_id", "upload_id", "job_id", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_name": { "const": "connector.ingestion.requested.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string" },
    "payload_version": { "const": 1 },
    "correlation_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "request_id": { "type": ["string", "null"] },
    "upload_id": { "type": "string" },
    "job_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["lease_id"],
      "properties": {
        "lease_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
