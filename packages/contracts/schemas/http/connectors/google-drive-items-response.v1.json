{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamgate.local/contracts/http/google-drive-items-response.v1.json",
  "title": "GoogleDriveItemsResponseV1",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "mime_type", "kind"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "mime_type": { "type": "string" },
          "kind": { "type": "string", "enum": ["file", "folder"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
