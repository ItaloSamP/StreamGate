{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamgate.local/contracts/http/google-drive-authorize-response.v1.json",
  "title": "GoogleDriveAuthorizeResponseV1",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["authorization_url", "state", "expires_at", "scopes"],
      "properties": {
        "authorization_url": { "type": "string", "format": "uri" },
        "state": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
