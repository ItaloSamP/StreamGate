{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamgate.local/contracts/http/analytics-warehouse-response.v1.json",
  "title": "AnalyticsWarehouseResponseV1",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["source", "generated_at", "lag_seconds", "stale", "slo_target_seconds", "p95_ms", "error_budget_percent", "dependency_status", "fallback_reason"],
      "properties": {
        "source": { "type": "string", "enum": ["clickhouse", "postgres_derived"] },
        "generated_at": { "type": "string", "format": "date-time" },
        "last_event_at": { "type": ["string", "null"], "format": "date-time" },
        "lag_seconds": { "type": ["integer", "null"] },
        "stale": { "type": "boolean" },
        "slo_target_seconds": { "type": "integer", "minimum": 1 },
        "p95_ms": { "type": "integer", "minimum": 0 },
        "error_budget_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "dependency_status": { "type": "object", "additionalProperties": true },
        "fallback_reason": { "type": ["string", "null"] },
        "aggregates": {
          "type": "object",
          "required": ["jobs_total", "uploads_total", "records_total", "valid_records", "invalid_records"],
          "properties": {
            "jobs_total": { "type": "integer", "minimum": 0 },
            "uploads_total": { "type": "integer", "minimum": 0 },
            "records_total": { "type": "integer", "minimum": 0 },
            "valid_records": { "type": "integer", "minimum": 0 },
            "invalid_records": { "type": "integer", "minimum": 0 },
            "by_status": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "by_source": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
