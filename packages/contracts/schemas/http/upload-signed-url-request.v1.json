{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamgate.local/contracts/http/upload-signed-url-request.v1.json",
  "title": "UploadSignedUrlRequestV1",
  "type": "object",
  "required": ["upload"],
  "properties": {
    "upload": {
      "type": "object",
      "required": ["filename", "content_type", "byte_size", "checksum_sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "content_type": { "type": "string", "enum": ["application/zip", "text/csv"] },
        "byte_size": { "type": "integer", "minimum": 1 },
        "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
