{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamgate.local/contracts/http/resources/operational-warning.v1.json",
  "title": "OperationalWarningResourceV1",
  "type": "object",
  "required": ["id", "code", "message", "status", "severity", "retry_count", "expires_at", "trace_id"],
  "properties": {
    "id": { "type": "string" },
    "job_id": { "type": ["string", "null"] },
    "upload_id": { "type": ["string", "null"] },
    "code": { "type": "string" },
    "message": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "retrying", "resolved", "failed"] },
    "severity": { "type": "string", "enum": ["info", "warning", "error"] },
    "retry_count": { "type": "integer", "minimum": 0 },
    "resolved_at": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
